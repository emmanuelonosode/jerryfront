# =============================================================================
# SKELTON REALTY GROUP — SITE CONFIGURATION
#
# Copy to `.env.local` and fill in. Every value below is printed on a public
# page, so none of it is secret — but all of it is a statement the company can
# be held to, which is why nothing here has an invented default.
#
#   Anything left blank renders a visible "TO CONFIRM" marker on the live page
#   and is reported by `node scripts/launch-gate.mjs`, which exits non-zero
#   until the list is empty. That is the deploy check: run it, fill what it
#   names, run it again.
#
# Payment account details are NOT here — they are entered in the Django admin
# under Billing → Payment method configs, because they change without a deploy.
# =============================================================================

# --- Where things are --------------------------------------------------------
# LEAVE BOTH BLANK FOR LOCAL DEVELOPMENT. Blank falls back to the working local
# defaults (http://127.0.0.1:8000/api/v1 for the API). Filling them with an
# example hostname is worse than leaving them empty: the site then points at a
# domain that does not exist and silently serves development fixtures instead
# of real inventory.
NEXT_PUBLIC_SITE_ORIGIN=https://skeltonrealtygroup.com
NEXT_PUBLIC_API_BASE_URL=https://admin.skeltonrealtygroup.com/api/v1

# NOTE: a DANGEROUSLY_ACCEPT_ALL_BACKEND_TOKENS flag was committed here, set to
# 1, described as skipping JWT signature validation. Nothing reads it -
# lib/auth/jwt.ts verifies every token and refuses to start without a real
# JWT_SECRET - so it was inert, but a switch named "turn the auth off" sitting
# pre-enabled in the file everyone copies is not something to leave lying
# around. Removed. If you need an auth bypass for local testing, use a real
# JWT_SECRET and mint a token.

# Email Alert System Config (nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Staff alerts carry applicant names — send them to an address the business
# controls, never a personal inbox. Unset means alerts are not sent at all.
ALERT_EMAIL_RECIPIENT=

# --- Who we are (footer, contact page, structured data) ----------------------
NEXT_PUBLIC_COMPANY_LEGAL_NAME=Skelton Realty Group
# Pipe-separated lines. A real, verifiable postal address — this is the single
# strongest signal to a renter checking whether the company is real.
NEXT_PUBLIC_COMPANY_ADDRESS="4445 Corporation Ln|Virginia Beach, VA 23462"
# Pipe-separated for more than one. Ten raw digits are formatted for you.
NEXT_PUBLIC_COMPANY_PHONE="(757) 208-2767"
# e.g. "Mon–Fri, 9am–6pm CT"
NEXT_PUBLIC_COMPANY_PHONE_HOURS="Mon–Fri, 9am–6pm CT"
NEXT_PUBLIC_COMPANY_EMAIL="housing@skeltonrealtygroup.com"
# Brokerage licences are NOT set here. A named broker per state, several
# licence formats, entity licences and state-mandated disclosure text do not
# fit one line - they live in lib/content/licensing.ts, in code, so a licence
# number cannot change without showing up in a diff.

# --- Lease facts shown on every listing --------------------------------------
NEXT_PUBLIC_LEASE_LENGTHS=
NEXT_PUBLIC_SECURITY_DEPOSIT_RANGE=
NEXT_PUBLIC_UTILITIES_RESIDENT_PAYS=
# Does the 24-hour decision clock run at weekends?
NEXT_PUBLIC_DECISION_CLOCK=

# --- Fee schedule ------------------------------------------------------------
# Amounts in dollars. Every one must be set before the schedule stops being
# marked provisional; a wrong fee is worse than a blank, because nothing on the
# page signals that it is wrong.
NEXT_PUBLIC_FEE_EFFECTIVE_FROM=
NEXT_PUBLIC_FEE_APPLICATION=
NEXT_PUBLIC_FEE_LEASE_ADMIN=
NEXT_PUBLIC_FEE_DEPOSIT_MIN=
NEXT_PUBLIC_FEE_DEPOSIT_MAX=
NEXT_PUBLIC_FEE_UTILITY_ADMIN=
# A percentage of base rent, e.g. 3.5
NEXT_PUBLIC_FEE_RESIDENT_SERVICES_PERCENT=
NEXT_PUBLIC_FEE_FILTER_DELIVERY=
NEXT_PUBLIC_FEE_PET_RENT=
NEXT_PUBLIC_FEE_LATE=

# --- Map tiles ---------------------------------------------------------------
# OpenStreetMap's public tiles are the default and fine for development. Their
# usage policy is not built for production traffic - point this at a paid host
# before launch.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
NEXT_PUBLIC_MAP_TILES_ARE_THEMED=false

# --- Server-side only --------------------------------------------------------
# Must match Django's JWT_SECRET, at least 32 characters. Never NEXT_PUBLIC_.
JWT_SECRET=
# How long listing pages may be served from cache, in seconds.
LISTINGS_REVALIDATE_SECONDS=300
